# Claude Fleet configuration (.env format).
# Copy to ~/.claude-fleet/.env (the default), or point at it with --config/-c.
# Every value is optional; real environment variables override what's here.

# --- Paths ---
# FLEET_ROOT=~/.claude-fleet/instances     # per-instance clones
# FLEET_DB=~/.claude-fleet/fleet.db         # SQLite state file
# FLEET_SECRETS=~/.claude-fleet/secrets     # per-instance git credential files

# --- Secrets / auth ---
# Fernet key that encrypts stored git credentials. Generate: python crypto.py
# FLEET_SECRET_KEY=
# If set, every request must carry this value in the X-Auth-Token header.
# FLEET_AUTH_TOKEN=

# --- Claude / remote-control ---
# CLAUDE_RC_CMD=claude remote-control
# RELAY_REGEX=https://claude\.ai/code/session_\S+

# --- Server ---
# FLEET_HOST=127.0.0.1     # keep loopback in production; front it with a proxy
# FLEET_PORT=8700

# --- Sandboxed Docker access for spawned sessions (optional) ---
# If set, every spawned session's `docker` CLI is pointed here instead of
# having no Docker access at all. See docs/deployment-k3s.md.
# DOCKER_HOST=tcp://docker-sandbox.claude-fleet.svc.cluster.local:2376
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/certs/client

# --- Environment briefing (optional) ---
# Markdown written into every spawned instance's global Claude memory file
# ($CLAUDE_CONFIG_DIR/CLAUDE.md) on spawn/rerun, so agents start out knowing
# deployment-specific facts instead of discovering them through trial and
# error. Wrap in double quotes to span multiple lines (or use \n). Any other
# content already in CLAUDE.md is left untouched.
# FLEET_ENVIRONMENT_BRIEFING="This cluster's docker-sandbox runs with --iptables=false.
# Use `docker run --network host ...` for outbound connectivity; a bridge
# network will silently have no internet access.
# Container registry mirror: registry.internal:5000"
